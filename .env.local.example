# Copia este archivo a .env.local y rellena tus valores.
# .env.local está gitignoreado: NUNCA se commitea (contiene secretos).
#
# Cargalo antes de correr los smoke tests:
#   set -a; source .env.local; set +a
#
# Este SDK usa SIEMPRE producción (https://workfloo.kiban.com).

# --- API key de producción (secreto) ---
export KIBAN_API_KEY_PROD=

# --- Datos de la ejecución de prueba ---
export KIBAN_WORKFLOO_DEFINITION_ID=
# Requerido sólo en modo sandbox si la definición tiene nodos LINK
# (salvo NIP / BC auditoría):
export KIBAN_SCENARIO_ID=

# --- Override opcional del modo ---
# Por defecto las llamadas corren en modo real (sandbox=false). Descomentá para
# correr en modo sandbox (no consume saldo; scenarioId requerido si hay LINK):
# export KIBAN_SANDBOX=true
